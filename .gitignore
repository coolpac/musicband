# Root .gitignore for monorepo (frontend + backend)

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Dependencies
**/node_modules/

# Env files (never commit real secrets)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Build outputs
# NOTE: frontend/public/site/ is generated too (scripts/generate-site-icons.mjs) but IS committed —
# the icons and the OG image must exist in the build context, not be re-rendered per deploy.
**/dist/
**/build/
**/.vite/
**/dist-ssr/
**/*.tsbuildinfo

# DB dumps written by deploy.sh and scripts/backup-db.sh (the server checkout must stay clean
# or `git pull` in deploy.sh aborts)
backups/

# Tests / coverage
**/coverage/
**/.nyc_output/

# Local uploads/exports (backend)
backend/uploads/
!backend/uploads/.gitkeep
backend/exports/
!backend/exports/.gitkeep


# git worktrees
.worktrees/

# Public site: raw Figma photo exports (2–12 MB each) stay local; the site imports only the
# AVIF/WebP variants generated into src/site/assets/opt/ by `npm run optimize:site`.
frontend/src/site/assets/*/*.png
frontend/src/site/assets/*/*.jpg
frontend/src/site/assets/*/*.jpeg
!frontend/src/site/assets/social/icon-youtube-4x.png
