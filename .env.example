# ===================================
# Музыканты — Production Environment
# ===================================
# Скопируйте в .env и заполните значения.
# cp .env.example .env

# --- Database ---
POSTGRES_DB=musicians_db
POSTGRES_USER=musicians
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# --- Telegram Bots ---
TELEGRAM_ADMIN_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_USER_BOT_TOKEN=654321:XYZ-ABC...
TELEGRAM_USER_BOT_USERNAME=vgulbot

# --- Max Bots (max.ru) ---
# Заполняются ОБА токена, чтобы включить Max (иначе — Telegram-only). Токены секретны.
# MAX_ADMIN_BOT_TOKEN=...
# MAX_USER_BOT_TOKEN=...
# MAX_USER_BOT_USERNAME=id744719465529_bot
# MAX_ADMIN_BOT_USERNAME=id744719465529_1_bot

# --- URLs ---
# CORS allow-list через запятую, без слэшей в конце: публичный сайт И хост Mini App.
# поэтому список через запятую здесь ломает кнопки ботов — не расширяйте его.
FRONTEND_URL=https://vgulcover.ru,https://vgul.cyberslon.ru
# Хост Mini App и админки — кнопки ботов и реферальные ссылки ведут сюда.
MINI_APP_URL=https://vgul.cyberslon.ru
ADMIN_PANEL_URL=https://vgul.cyberslon.ru/admin

# --- Публичный сайт (контейнер `site`, SSR) ---
# Общий секрет для POST {SITE_SSR_URL}/__purge: backend дёргает его после сохранения
# раздела в админке, чтобы сайт сразу перерисовался, не дожидаясь SITE_CACHE_TTL_MS.
# Пустое значение = хук открыт без авторизации (сеть внутренняя, но лучше задать).
# Сгенерировать: openssl rand -hex 32
SITE_PURGE_TOKEN=

# Куда backend шлёт purge. Значение по умолчанию подходит для docker-compose.
SITE_SSR_URL=http://site:4000

# Откуда SSR-сервер берёт контент (GET /api/public/site). По умолчанию — backend в той же сети.
SITE_API_ORIGIN=http://backend:3000

# Сколько мс отданные API-данные считаются свежими. По истечении срока страница всё равно
# отдаётся мгновенно, а данные обновляются в фоне (stale-while-revalidate).
SITE_CACHE_TTL_MS=30000

# --- Admin (опционально: хеш пароля для входа в админку без Telegram) ---
# Сгенерировать: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('your-password',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# --- Server ---
APP_PORT=80

# --- Multi-tenant deployment (REQUIRED CHOICE) ---
# `deploy.sh` вызывает docker compose без -f, поэтому режим задаётся только здесь.
# Пока docker-compose.host-proxy.yml лежит в репозитории, deploy.sh откажется работать,
# если не выбран один из двух вариантов.
#
# (1) За host-level nginx (текущий прод): TLS терминирует хост, контейнер слушает localhost.
# COMPOSE_FILE=docker-compose.yml:docker-compose.host-proxy.yml
# HOST_PROXY_PORT=8084
#
# (2) Standalone: TLS терминирует сам контейнер, он занимает :80 и :443.
# DEPLOY_MODE=standalone
