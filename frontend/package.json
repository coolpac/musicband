{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/site/entry-server.tsx --outDir dist-ssr && node scripts/prerender-site.mjs",
    "preview": "vite preview",
    "analyze": "ANALYZE=true vite build",
    "optimize": "node scripts/optimize-assets.mjs",
    "optimize:site": "node scripts/optimize-site-images.mjs",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "site:serve": "node server/site-server.mjs",
    "icons:site": "node scripts/generate-site-icons.mjs",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/island-moments": "^5.3.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "sharp": "^0.34.0",
    "svgo": "^4.0.0",
    "terser": "^5.36.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
