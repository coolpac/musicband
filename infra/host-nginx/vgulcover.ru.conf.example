# Host-level nginx vhost for vgulcover.ru on a multi-tenant server.
# Installed at /etc/nginx/sites-available/vgulcover.ru.conf on the host
# (NOT inside the docker container). Symlink to sites-enabled to activate.
#
# Notes:
#   - http2 is on the listen directive (legacy syntax) because nginx 1.24
#     on Ubuntu 24.04 does not support the newer `http2 on;` directive.
#   - client_max_body_size 64m here matches the container's /api/ override
#     so large image uploads aren't 413-rejected at the outer layer.
#   - Proxies to the frontend container on 127.0.0.1:8084 (set by
#     HOST_PROXY_PORT in docker-compose.host-proxy.yml).

server {
    listen 80;
    listen [::]:80;
    server_name vgulcover.ru www.vgulcover.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name vgulcover.ru www.vgulcover.ru;

    ssl_certificate     /etc/letsencrypt/live/vgulcover.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vgulcover.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 64m;

    # Security headers (the in-container nginx-behind-proxy.conf also sets the
    # first three, but the host edge is the authoritative place — duplicating
    # is harmless and survives container-side regressions).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # frame-ancestors вместо X-Frame-Options: Mini App встраивается в Telegram и Max.
    # X-Frame-Options не умеет несколько источников, поэтому используем CSP.
    add_header Content-Security-Policy "frame-ancestors 'self' https://*.telegram.org https://web.telegram.org https://*.max.ru https://max.ru" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:8084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
